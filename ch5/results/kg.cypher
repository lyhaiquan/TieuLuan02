// Đồ thị tri thức Chương 5 - sinh tự động bởi build_kg.py
// Nạp:  cat kg.cypher | cypher-shell -u neo4j -p <mat khau>
CREATE CONSTRAINT entity_id IF NOT EXISTS
FOR (n:Entity) REQUIRE n.id IS UNIQUE;

MERGE (n:Entity:Asset {id: 'GOLD'}) SET n.name = 'GOLD', n.has_series = true, n.domain = 'gold';
MERGE (n:Entity:Asset {id: 'SILVER'}) SET n.name = 'SILVER', n.has_series = true, n.domain = 'gold';
MERGE (n:Entity:Asset {id: 'OIL'}) SET n.name = 'OIL', n.has_series = true, n.domain = 'gold';
MERGE (n:Entity:Asset {id: 'SP500'}) SET n.name = 'SP500', n.has_series = true, n.domain = 'gold';
MERGE (n:Entity:Asset {id: 'BTC'}) SET n.name = 'BTC', n.has_series = true, n.domain = 'gold';
MERGE (n:Entity:MacroIndicator {id: 'USD'}) SET n.name = 'USD', n.has_series = true, n.domain = 'gold';
MERGE (n:Entity:MacroIndicator {id: 'US10Y'}) SET n.name = 'US10Y', n.has_series = true, n.domain = 'gold';
MERGE (n:Entity:MacroIndicator {id: 'VIX'}) SET n.name = 'VIX', n.has_series = true, n.domain = 'gold';
MERGE (n:Entity:Institution {id: 'FED'}) SET n.name = 'FED', n.has_series = false, n.domain = 'gold';
MERGE (n:Entity:MacroIndicator {id: 'INFLATION'}) SET n.name = 'INFLATION', n.has_series = false, n.domain = 'gold';
MERGE (n:Entity:Theme {id: 'GEOPOLITICS'}) SET n.name = 'GEOPOLITICS', n.has_series = false, n.domain = 'gold';
MERGE (n:Entity:Theme {id: 'RECESSION'}) SET n.name = 'RECESSION', n.has_series = false, n.domain = 'gold';
MERGE (n:Entity:Stock {id: 'VNM'}) SET n.name = 'VNM', n.has_series = true, n.domain = 'stock';
MERGE (n:Entity:Stock {id: 'FPT'}) SET n.name = 'FPT', n.has_series = true, n.domain = 'stock';
MERGE (n:Entity:Stock {id: 'VCB'}) SET n.name = 'VCB', n.has_series = true, n.domain = 'stock';
MERGE (n:Entity:Stock {id: 'HPG'}) SET n.name = 'HPG', n.has_series = true, n.domain = 'stock';
MERGE (n:Entity:Stock {id: 'VIC'}) SET n.name = 'VIC', n.has_series = true, n.domain = 'stock';
MERGE (n:Entity:Industry {id: 'Packaged Foods'}) SET n.name = 'Packaged Foods', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Sector {id: 'Consumer Defensive'}) SET n.name = 'Consumer Defensive', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Country {id: 'Vietnam'}) SET n.name = 'Vietnam', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Industry {id: 'Information Technology Services'}) SET n.name = 'Information Technology Services', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Sector {id: 'Technology'}) SET n.name = 'Technology', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Industry {id: 'Banks - Regional'}) SET n.name = 'Banks - Regional', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Sector {id: 'Financial Services'}) SET n.name = 'Financial Services', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Industry {id: 'Steel'}) SET n.name = 'Steel', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Sector {id: 'Basic Materials'}) SET n.name = 'Basic Materials', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Industry {id: 'Real Estate Services'}) SET n.name = 'Real Estate Services', n.has_series = false, n.domain = 'stock';
MERGE (n:Entity:Sector {id: 'Real Estate'}) SET n.name = 'Real Estate', n.has_series = false, n.domain = 'stock';

MATCH (a:Entity {id: 'GOLD'}), (b:Entity {id: 'SILVER'}) MERGE (a)-[r:correlates_with {corr: 0.751, domain: 'gold', n_days: 61, period: '2020-03-31'}]->(b);
MATCH (a:Entity {id: 'GOLD'}), (b:Entity {id: 'SILVER'}) MERGE (a)-[r:correlates_with {corr: 0.734, domain: 'gold', n_days: 62, period: '2020-06-30'}]->(b);
